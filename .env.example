# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://techstore.netlify.app
BACKEND_URL=https://camiloalvarezbackend-production.up.railway.app

# Database (Railway MySQL)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=railway

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Mercado Pago
MP_ACCESS_TOKEN=your-mercado-pago-access-token
MP_PUBLIC_KEY=your-mercado-pago-public-key
MP_WEBHOOK_SECRET=your-webhook-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=TechStore <noreply@techstore.com>

# Admin seed
ADMIN_EMAIL=admin@techstore.com
ADMIN_PASSWORD=your-admin-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=TechStore
