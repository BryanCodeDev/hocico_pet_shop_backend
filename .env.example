# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://hocico.com.co
BACKEND_URL=https://camiloalvarezbackend-production.up.railway.app

# Database (Railway MySQL)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=railway

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Wompi
WOMPI_PUBLIC_KEY=your-wompi-public-key
WOMPI_PRIVATE_KEY=your-wompi-private-key
WOMPI_INTEGRITY_SECRET=your-wompi-integrity-secret
WOMPI_EVENTS_SECRET=your-wompi-events-secret
WOMPI_ENV=sandbox

# Factus (facturación electrónica)
FACTUS_BASE_URL=https://api.factus.com.co
FACTUS_CLIENT_ID=your-factus-client-id
FACTUS_CLIENT_SECRET=your-factus-client-secret
FACTUS_EMAIL=your-factus-email
FACTUS_PASSWORD=your-factus-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Hocico Pet Shop <noreply@hocico.com.co>

# Admin seed
ADMIN_EMAIL=admin@hocico.com.co
ADMIN_PASSWORD=your-admin-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Hocico
