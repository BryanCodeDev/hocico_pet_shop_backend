# =============================================================================
# Hocico Pet Shop - Backend (PLANTILLA)
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` y reemplaza cada valor `CHANGE_ME`.
# `.env` está en .gitignore: nunca subas credenciales reales al repositorio.
# En Railway/Producción NO se usa este archivo: configura las variables desde
# el panel del servicio.
#
# Estructura verificada contra `rg "process\.env\." src`: se listan únicamente
# variables que el código lee, y están todas las que lee.
# =============================================================================

# --- Servidor -----------------------------------------------------------------
# development: expone stack de errores. production: los oculta.
NODE_ENV=production
PORT=3001

# Frontend público. Origen usado en los redirects de regreso tras el pago
# (paymentController.js, posController.js). Debe ser el dominio real, sin
# barra final.
#   Producción: https://hocico-pet-shop.netlify.app
#   Local:      http://localhost:5173
FRONTEND_URL=https://hocico-pet-shop.netlify.app

# --- Rate limiting (app.js) ---------------------------------------------------
# Ventana y máximo de peticiones por IP. Si se omiten, el código usa
# 900000 ms y 100 req.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Base de datos (config/database.js, utils/migrate.js) ----------------------
DB_HOST=CHANGE_ME_db_host
DB_PORT=3306
DB_USER=CHANGE_ME_db_user
DB_PASSWORD=CHANGE_ME_db_password
DB_NAME=hocico_pet_shop

# --- JWT (middleware/auth.js, controllers/authController.js) -------------------
# Firma los tokens de sesión. Genera una aleatoria de 32+ caracteres.
# El valor por defecto del código es un placeholder conocido: no lo dejes.
JWT_SECRET=CHANGE_ME_min_32_chars_random_string

# --- Wompi (controllers/paymentController.js, controllers/posController.js) ---
# El checkout se abre con la clave PÚBLICA; la clave privada no la usa el código.
# WOMPI_ENV: sandbox = pruebas (pay.pruebas.wompi.co) | production = cobros reales
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=CHANGE_ME_wompi_public_key
WOMPI_INTEGRITY_SECRET=CHANGE_ME_wompi_integrity_secret
WOMPI_EVENTS_SECRET=CHANGE_ME_wompi_events_secret

# --- Factus / facturación electrónica (utils/factusService.js) -----------------
FACTUS_BASE_URL=https://api.factus.com.co
FACTUS_CLIENT_ID=CHANGE_ME_factus_client_id
FACTUS_CLIENT_SECRET=CHANGE_ME_factus_client_secret
FACTUS_EMAIL=CHANGE_ME_factus_email
FACTUS_PASSWORD=CHANGE_ME_factus_password
# IVA y parámetros de la DIAN. 1101 = Bogotá. Ajusta si facturas a otro municipio.
FACTUS_IVA=19
FACTUS_MUNICIPALITY_ID=1101
FACTUS_NUMBERING_RANGE_ID=8

# --- Cloudinary (config/cloudinary.js) ----------------------------------------
# Opcional: vacío = la carga de imágenes no funciona; el resto de la API sí.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed del admin (seeders/createAdmin.js) ----------------------------------
# Se ejecuta en cada arranque y crea el admin inicial si la tabla está vacía.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Hocico

# =============================================================================
# No declaradas aquí porque el código no las lee:
#   WOMPI_PRIVATE_KEY   - el checkout usa solo la clave pública
#   BACKEND_URL         - sin referencias en src/
#   SMTP_* / EMAIL_FROM - no hay envío de correo implementado
#   VITE_WHATSAPP_NUMBER - es del frontend; va en frontend/.env.example
#
# Para pruebas, vitest.config.js sobrescribe NODE_ENV, DB_NAME (a <DB_NAME>_test),
# JWT_SECRET, RATE_LIMIT_* y las claves de Wompi. No hace falta una .env.test.
# =============================================================================
